"ok": s.LastOK,
"latency_ms": s.LatencyMs,
"ping_count": s.PingCount,
"error_count": s.ErrorCount,
"face_count": s.FaceCount,
"uptime_s": int64(time.Since(s.Uptime).Seconds()),
"last_ping": s.LastPing.Format(time.RFC3339),
