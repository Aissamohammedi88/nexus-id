# ─ Handler HTTP ─
class H(BaseHTTPRequestHandler):
server_version = 'NexusFaceIDOmega/' + VERSION
protocol_version = 'HTTP/1.1'
def lm(self,*a): pass
def _send(self,code,body,ct='text/html;charset=utf-8'):
if isinstance(body,str): body=body.encode('utf-8')
try:
self.send_response(code)
self.send_header('Content-Type',ct)
self.send_header('Content-Length',str(len(body)))
self.send_header('Access-Control-Allow-Origin','*')
self.send_header('Cache-Control','no-store')
self.end_headers(); self.wfile.write(body)
except (BrokenPipeError,ConnectionResetError): pass
def _json(self,code,obj): self._send(code,json.dumps(obj,indent=2,ensure_ascii=False,default=str),'application/json;charset=utf-8')
def _body(self,mx=20_000_000):
try: n=int(self.headers.get('Content-Length','0') or '0')
except: n=0
return self.rfile.read(n) if 0 < n <= mx else b''
def _parse(self):
p=urllib.parse.urlparse(self.path); return p.path,urllib.parse.parse_qs(p.query)
def do_GET(self):
path,qs=self._parse()
if path in ('/','/index.html'):
return self._send(200,HTML.replace('__V__',VERSION))
if path=='/api/status':
db=db_load(); ses=ses_load(); now=time.time()
actives=sum(1 for s in ses.values() if s.get('expire',0)>now)
return self._json(200,{'ok':True,'version':VERSION,'auteur':AUTEUR,
'port':PORT,'visages':db.get('total',0),'sessions_actives':actives,
'seuil_match':SEUIL_MATCH,'seuil_individuel':SEUIL_INDIV,
'angles':ANGLES,'backends':backend_info()})
if path=='/api/liste': return self._json(200,{'ok':True,'items':lister()})
if path=='/api/session/verifier':
return self._json(200,ses_verifier(qs.get('sid',[''])[0]))
if path='/api/backends': return self._json(200,{'ok':True,'backends':backend_info()})
return self._json(404,{'ok':False,'err':'route inconnue'})
def do_POST(self):
path,qs=self._parse()
if path=='/api/enregistrer':
nom=qs.get('nom',[''])[0]; angle=qs.get('angle',['face'])[0]
res=enregistrer(nom,angle,self._body())
tlog({'action':'enregistrer','nom':nom,'angle':angle,'resultat':res})
return self._json(200,res)
if path=='/api/verifier':
res=verifier(self._body()); tlog({'action':'verifier','resultat':res})
return self._json(200,res)
if path=='/api/supprimer': return self._json(200,supprimer(qs.get('id',[''])[0]))
if path=='/api/supprimer_tout': return self._json(200,supprimer_tout())
if path=='/api/session/creer':
data=json.loads(self._body().decode('utf-8','ignore') or '{}')
return self._json(200,ses_creer(data.get('visage','?'),int(data.get('duree',TIMEOUT_SES))))
if path=='/api/session/supprimer':
data=json.loads(self._body().decode('utf-8','ignore') or '{}')
sid=re.sub(r'[^a-f0-9]','',data.get('sid',''))[:64]
ses=ses_load()
if sid in ses: del ses[sid]; ses_save(ses)
return self._json(200,{'ok':True})
return self._json(404,{'ok':False,'err':'route inconnue'})
def do_OPTIONS(self):
try:
self.send_response(204)
self.send_header('Access-Control-Allow-Origin','*')
self.send_header('Access-Control-Allow-Methods','GET,POST,OPTIONS')
self.send_header('Access-Control-Allow-Headers','*')
self.send_header('Content-Length','0'); self.end_headers()
except: pass

