}

/* ─── CAMERA ─── */
async function startCam(){
try{
if(stream)stream.getTracks().forEach(t=>t.stop());
stream=await navigator.mediaDevices.getUserMedia({
video:{facingMode:facing,width:{ideal:720},height:{ideal:720}},audio:false
});
const v=document.getElementById('vid');
v.srcObject=stream;
v.style.transform=facing==='user'?'scaleX(-1)':'scaleX(1)';
setBot('CAMERA ACTIVE');
}catch(e){setBot('ERREUR: '+e.message);}
}
function flipCam(){facing=facing==='user'?'environment':'user';startCam();}
function stopCam(){
if(stream){stream.getTracks().forEach(t=>t.stop());stream=null;}
document.getElementById('vid').srcObject=null;
setBot('CAMERA INACTIVE');
}
fonction setBot(t){document.getElementById('ov-bot').textContent=t;}
fonction setTop(t){document.getElementById('ov-top').textContent=t;}

function capture(){
const v=document.getElementById('vid');
const c=document.getElementById('cnv');
if(!v.videoWidth)return null;
c.width=320;c.height=320;
const ctx=c.getContext('2d');
ctx.drawImage(v,0,0,320,320);
return c.toDataURL('image/jpeg',0.88);
}
function dataToBlob(d){
const arr=d.split(','),mime=arr[0].match(/:([^;]+)/)[1];
const bin=atob(arr[1]),bytes=new Uint8Array(bin.length);
for(let i=0;i<bin.length;i++)bytes[i]=bin.charCodeAt(i);
return new Blob([bytes],{type:mime});
}

function showRes(id,html,cls){
