// Cosinus sur deux vecteurs (produit scalaire / norme)
double cosine(const std::vector<double>& a, const std::vector<double>& b) {
if (a.size() != b.size() || a.empty()) return 0.0;
double dot = 0.0, na = 0.0, nb = 0.0;
const std::size_t n = a.size();

// Unroll 4 : réduction par blocs de 4
std::size_t i = 0;
pour (; i + 3 < n; i += 4) {
dot += a[i]*b[i] + a[i+1]*b[i+1] + a[i+2]*b[i+2] + a[i+3]*b[i+3];
na += a[i]*a[i] + a[i+1]*a[i+1] + a[i+2]*a[i+2] + a[i+3]*a[i+3];
nb += b[i]*b[i] + b[i+1]*b[i+1] + b[i+2]*b[i+2] + b[i+3]*b[i+3];
}
for (; i < n; ++i) { dot += a[i]*b[i]; na += a[i]*a[i]; nb += b[i]*b[i]; }
if (na <= 0.0 || nb <= 0.0) return 0.0;
double c = dot / (std::sqrt(na) * std::sqrt(nb));
return std::max(0.0, std::min(1.0, (c + 1.0) / 2.0));
}

// Parse un tableau JSON de doubles : [1.2, -0.3, ...]
std::vector<double> parse_array(const std::string& s) {
std::vector<double> v;
std::size_t p = s.find('[');
if (p == std::string::npos) return v;
std::size_t q = s.rfind(']');
if (q == std::string::npos || q <= p) return v;
std::string inner = s.substr(p + 1, q - p - 1);
std::istringstream ss(inner);
std::string tok;
while (std::getline(ss, tok, ',')) {
tok.erase(std::remove_if(tok.begin(), tok.end(),
[](char c){ return c == ' ' || c == '\n' || c == '\r' || c == '\t'; }), tok.end());
if (!tok.empty()) {
try { v.push_back(std::stod(tok)); } catch (...) {}
}
}
return v;
}

