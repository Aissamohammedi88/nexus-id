import java.security.*;
import java.security.spec.*;
import java.util.*;
import java.io.*;
import java.nio.file.*;
import java.nio.charset.StandardCharsets;
import javax.crypto.*;
import javax.crypto.spec.*;
import java.time.*;
import java.time.format.*;

public class NexusSession {
static final String VERSION = "3.0.0";
static final String SECRET = System.getenv().getOrDefault("NEXUS_SESSION_SECRET",
"nexus-faceid-omega-secret-key-2026");
static final String ALGO = "HmacSHA256";
static final DateTimeFormatter ISO = DateTimeFormatter.ISO_INSTANT;

// Génère un token : base64(header.payload).signature
static String generate(String visage, long dureeS) throws Exception {
String sid = UUID.randomUUID().toString().replace("-", "").substring(0, 16);
long created = Instant.now().getEpochSecond();
long expires = created + dureeS;
String payload = String.format(
"{\"sid\":\"%s\",\"v\":\"%s\",\"iat\":%d,\"exp\":%d,\"ver\":\"%s\"}",
sid, visage, created, expires, VERSION);
Chaîne encodée = Base64.getUrlEncoder().sansPadding()
.encodeToString(payload.getBytes(StandardCharsets.UTF_8));
String sig = hmac(encoded);
return encoded + "." + sig;
}

// Vérifie un token, retourne le payload ou null si invalide/expiré
static String verify(String token) throws Exception {
String[] parts = token.split("\\.", 2);
if (parts.length != 2) return null;
String encoded = parts[0];
String sig = parts[1];
if (!hmac(encoded).equals(sig)) return null; // signature invalide
byte[] bytes = Base64.getUrlDecoder().decode(encoded);
String payload = new String(bytes, StandardCharsets.UTF_8);
// Extraire exp
int expIdx = payload.indexOf("\"exp\":");
if (expIdx < 0) return null;
String after = payload.substring(expIdx + 6);
long exp = Long.parseLong(after.replaceAll("[^0-9]", "").substring(0, 10));
if (Instant.now().getEpochSecond() > exp) return null; // expiré
return payload;
}

statique String hmac(String data) lance Exception {
Mac mac = Mac.getInstance(ALGO);
mac.init(new SecretKeySpec(SECRET.getBytes(StandardCharsets.UTF_8), ALGO));
byte[] raw = mac.doFinal(data.getBytes(StandardCharsets.UTF_8));
return Base64.getUrlEncoder().withoutPadding().encodeToString(raw).substring(0, 32);
}

