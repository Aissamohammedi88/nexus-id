const LABELS={
fr:{face:'Face',gauche:'Gauche',droite:'Droite'},
en:{face:'Front',gauche:'Left',droite:'Right'},
ar:{face:'واجهة',gauche:'يسار',droite:'يمين'}
};
let lang='fr';

fonction setLang(l){lang=l;updateLabels();}
function updateLabels(){
const L=LABELS[lang]||LABELS.fr;
document.getElementById('lbl-face').textContent=L.face;
document.getElementById('lbl-gauche').textContent=L.gauche;
document.getElementById('lbl-droite').textContent=L.droite;
