if(!j.ok){showRes('r-verif','&#10007; '+esc(j.err||'?'),'non');return;}
if(j.match){
const pct=(j.score*100).toFixed(1);
showRes('r-verif','&#10003; CONNU — <b>'+esc(j.nom)+'</b><br>'
+'Confiance : '+pct+'% (seuil '+(j.seuil*100).toFixed(0)+'%)<br>'
+'Temps : '+dt+' ms','oui');
await fetch('/api/session/creer',{method:'POST',
headers:{'Content-Type':'application/json'},
body:JSON.stringify({visage:j.nom})});
}else{
const pct=(j.score*100).toFixed(1);
showRes('r-verif','&#10007; INCONNU<br>Meilleur : '+pct
+'% (seuil '+(j.seuil*100).toFixed(0)+'%)<br>Temps : '+dt+' ms','non');
}
const det=document.getElementById('det-verif');
det.style.display='block';det.textContent=JSON.stringify(j,null,2);
updateBadges(j.backends||{});
}catch(e){showRes('r-verif','&#10007; Réseau : '+e.message,'non');}
}

