start_go_daemon() {
if [[ -x "${BUILD_DIR}/faceid_go" ]]; then
log_info "Démarrage démon santé Go (port $((PORT+1)))..."
HEALTH_PORT=$((PORT+1)) "${BUILD_DIR}/faceid_go" \
> "${LOGS_DIR}/go_daemon.log" 2>&1 &
GO_PID=$!
echo "${GO_PID}" > "${BASE}/go.pid"
log_ok "Démon Go PID=${GO_PID} — http://localhost:$((PORT+1))/health"
fi
}

stop_daemons() {
if [[ -f "${BASE}/go.pid" ]]; then
local pid; pid=$(cat "${BASE}/go.pid" 2>/dev/null || echo '')
[[ -n "$pid" ]] && kill "$pid" 2>/dev/null && log_ok "Démon Go arrêté" || true
rm -f "${BASE}/go.pid"
fi
}

launch_server() {
if ! cmd_exists python3; then
log_err "python3 requis pour le serveur principal."
exit 1
fi
start_go_daemon
log_ok "Lancement serveur Face ID sur port ${PORT}..."
log_info "Accès : http://$(ip_locale):${PORT}/ (n'importe quel appareil du réseau)"
NEXUS_PORT=${PORT} python3 "${SRC_DIR}/faceid_server.py"
}

