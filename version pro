el.className='res on '+cls;el.innerHTML=html;
}

/* ─── ANGLES ─── */
function nextAngle(){
if(!anglesDone.face)return 'face';
if(!anglesDone.gauche)return 'gauche';
if(!anglesDone.droite)return 'droite';
return null;
}
function updAngles(){
['face','gauche','droite'].forEach(a=>{
const el=document.getElementById('a-'+a);
el.className='angle'+(anglesDone[a]?' on':a===angleCur?' cur':'');
});
document.getElementById('cur-lbl').textContent=
(LABELS[lang]||LABELS.fr)[angleCur].toUpperCase();
}
function resetAng(){
angleCur='face';anglesDone={face:false,gauche:false,droite:false};
updAngles();document.getElementById('r-enreg').className='res';
}

async function captureAngle(){
const nom=document.getElementById('nom').value.trim();
if(!nom){alert('Saisis ton nom');return;}
const d=capture();
if(!d){alert('Camera pas prête');return;}
showRes('r-enreg','Capture '+angleCur.toUpperCase()+'...','att');
try{
const r=await fetch('/api/enregistrer?nom='+encodeURIComponent(nom)
+'&angle='+encodeURIComponent(angleCur),{method:'POST',body:dataToBlob(d)});
const j=await r.json();
if(!j.ok){showRes('r-enreg','&#10007; '+esc(j.err||'?'),'non');return;}
anglesDone[angleCur]=true;
const nx=nextAngle();
if(nx){
angleCur=nx;
const L=LABELS[lang]||LABELS.fr;
showRes('r-enreg','&#10003; '+j.angle.toUpperCase()+' OK ('+j.nb_angles+'/3)<br>'
+'&#10140; Tourne : <b>'+L[nx].toUpperCase()+'</b>','oui');
