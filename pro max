std::vector<double> parse_array(const std::string& s) {
std::vector<double> v;
std::size_t p = s.find('[');
if (p == std::string::npos) return v;
std::size_t q = s.rfind(']');
if (q == std::string::npos || q <= p) return v;
std::string inner = s.substr(p + 1, q - p - 1);
std::istringstream ss(inner);
std::string tok;
