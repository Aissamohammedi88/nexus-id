printf "${G}${BOLD}═══════════════════════════════════════════════════════════${N}\n"
echo ""
printf " ${B}Local${N} : ${C}http://localhost:${PORT}/${N}\n"
printf " ${B}Réseau${N} : ${C}http://${ip}:${PORT}/${N}\n"
printf " ${B}Health${N} : ${C}http://${ip}:$((PORT + HEALTH_PORT_OFFSET))/health${N}\n"
echo ""
printf " ${D}Base : ${BASE}${N}\n"
printf " ${D}Log : ${SERVER_LOG}${N}\n"
printf " ${D}PID : $(cat "${SERVER_PID}" 2>/dev/null || echo '?')${N}\n"
echo ""
printf " ${Y}► Ouvre l'URL dans Safari/Chrome (téléphone sur le même Wi-Fi)${N}\n"
echo ""
printf " ${D}Pour arrêter : kill \$(cat ${SERVER_PID})${N}\n"
printf " ${D}Pour relancer : $0 --run${N}\n"
echo ""

# Ouvrir le navigateur
local url="http://localhost:${PORT}/"
if cmd_exists xdg-open; then
log_info "Ouverture du navigateur..."
xdg-open "$url" >/dev/null 2>&1 &
elif cmd_exists sensible-browser; then
navigateur sensible "$url" >/dev/null 2>&1 &
elif cmd_exists firefox; then
firefox "$url" >/dev/null 2>&1 &
elif cmd_exists google-chrome; then
google-chrome "$url" >/dev/null 2>&1 &
fi

echo ""
}

# ════════════════════════════════════════════════════��
# MODES CLI
# ════════════════════════════════════════════════════��
mode_install() {
banner
log_file "=== NEXUS ID v${VERSION} — installation ==="
step_deps
step_structure
step_generate
step_compile
step_port
step_firewall
step_launch
step_test
step_final
}

mode_run() {
banner
if [ ! -f "${SERVER_PY}" ]; then
log_err "Sources absents — lance d'abord : $0 --install"
sortie 1
fi
step_port
step_firewall
step_launch
step_test
step_final
}

mode_stop() {
banner
log_step "Arrêt des services"
sept
if [ -f "${SERVER_PID}" ]; then
local pid
pid=$(cat "${SERVER_PID}" 2>/dev/null || echo "")
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
kill "$pid" 2>/dev/null
log_ok "Serveur Python arrêté (pid $pid)"
fi
rm -f "${SERVER_PID}"
fi
if [ -f "${GO_PID_FILE}" ]; then
local go_pid
go_pid=$(cat "${GO_PID_FILE}" 2>/dev/null || echo "")
si [ -n "$go_pid" ] && tuer -0 "$go_pid" 2>/dev/null; alors
tuer "$go_pid" 2>/dev/null
log_ok "Démon Go arrêté (pid $go_pid)"
fi
rm -f "${GO_PID_FILE}"
fi
echo ""
}

mode_status() {
banner
log_step "État des services"
sept
if [ -f "${SERVER_PID}" ]; then
local pid
pid=$(cat "${SERVER_PID}" 2>/dev/null || echo "")
if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
log_ok "Serveur Python ACTIF (pid $pid)"
d'autre
log_err "Serveur Python INACTIF (pid mort)"
fi
d'autre
log_warn "Serveur Python non démarré"
fi
if [ -f "${GO_PID_FILE}" ]; then
local go_pid
go_pid=$(cat "${GO_PID_FILE}" 2>/dev/null || echo "")
if [ -n "$go_pid" ] && kill -0 "$go_pid" 2>/dev/null; then
log_ok "Démon Go ACTIF (pid $go_pid)"
fi
fi
echo ""
printf " ${B}Port${N} : ${PORT_PREF}\n"
printf " ${B}Base${N} : ${BASE}\n"
printf " ${B}Logs${N} : ${LOGS_DIR}\n"
echo ""
}

mode_help() {
banner
printf " ${B}Usage${N} : $0 [OPTION]\n\n"
printf " ${G}--install${N} Installation complète + lancement\n"
printf " ${G}--run${N} Lancer le serveur (déjà installé)\n"
printf " ${G}--stop${N} Arrêter les services\n"
printf " ${G}--status${N} État des services\n"
printf " ${G}--uninstall${N} Désinstaller (garde les données)\n"
printf " ${G}--purge${N} Tout supprimer (données incluses)\n"
printf " ${G}--help${N} Cette aide\n"
printf " ${G}--version${N} Afficher la version\n"
echo ""
}

mode_uninstall() {
banner
log_step "Désinstallation"
sept
mode_stop
si [ -d "${BUILD_DIR}" ]; puis
rm -rf "${BUILD_DIR}"
log_ok "Binaires supprimés"
fi
if [ -d "${SRC_DIR}" ]; then
rm -rf "${SRC_DIR}"
log_ok "Sources supprimés"
fi
log_info "Données préservées : ${RESULTS_DIR}"
echo ""
}

mode_purge() {
banner
log_step "Purge totale"
sept
mode_stop
if [ -d "${BASE}" ]; then
rm -rf "${BASE}"
log_ok "Base supprimée : ${BASE}"
fi
echo ""
}

# ════════════════════════════════════════════════════��
# MAIN
# ════════════════════════════════════════════════════��
main() {
case "${1:-}" in
--install|install) mode_install ;;
--run|run) mode_run ;;
--stop|stop) mode_stop ;;
--status|status) mode_status ;;
--uninstall) mode_uninstall ;;
--purge) mode_purge ;;
--version|version) echo "NEXUS ID v${VERSION}" ;;
--help|-h|help) mode_help ;;
"")
# Menu interactif
bannière
echo " Que want-tu faire ?"
echo ""
echo " 1) Installation complète + lancement"
echo " 2) Lancer le serveur "
echo " 3) Arrêter"
echo " 4) État"
echo " 5) Désinstaller "
echo " 6) Purger (tout) "
echo " 0) Quitter"
echo ""
printf " Choix : "
read -r choix
cas "$choix" dans
1) mode_install ;;
2) mode_run ;;
3) mode_stop ;;
4) mode_status ;;
5) mode_uninstall ;;
6) mode_purge ;;
0|q) sortie 0 ;;
*) écho "Choix invalide" ;
Esac
;;
*)
echo "Option inconnue : 1 $"
mode_help
sortie 1
;;
Esac
}

principal "$@"
